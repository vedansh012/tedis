# ------------------------------------------------------------------
# TedIS environment. Copy to `.env` and fill in. NEVER commit `.env`.
# Validated at boot by src/config/env.ts — the app refuses to start if invalid.
# ------------------------------------------------------------------

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=TedIS

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://tedis:tedis@localhost:5432/tedis?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth secrets — generate with: openssl rand -base64 48
SESSION_SECRET=replace_me_with_48_bytes_base64
CSRF_SECRET=replace_me_with_48_bytes_base64
# WebAuthn relying party
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TedIS
WEBAUTHN_ORIGIN=http://localhost:3000

# OAuth (Increment 3) — create apps, then fill
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Email (transactional: verification + password reset) -------------------
#
# EMAIL_PROVIDER=console  -> prints messages to the server log. The default, and
#                            the right setting for local dev: every flow is
#                            fully testable, links included, with no account.
# EMAIL_PROVIDER=resend   -> real delivery. The app REFUSES TO BOOT unless both
#                            RESEND_API_KEY and EMAIL_FROM are also set.
#
# EMAIL_FROM accepts a bare address or a display name:
#   no-reply@yourdomain.com
#   TedIS <no-reply@yourdomain.com>        <- preferred in production
#
# Before you can send to ANYONE other than your own Resend account address, the
# sending domain must be verified in Resend (SPF + DKIM TXT records, added as
# "DNS only" / grey-cloud in Cloudflare — proxying breaks them). Until then use
# EMAIL_FROM=onboarding@resend.dev, which needs no domain but only delivers to
# the address the Resend account was created with.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@tedis.app
RESEND_API_KEY=

# Object storage — S3-compatible (Cloudflare R2 recommended, or AWS S3).
# Leave ALL of the required four (BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY,
# PUBLIC_URL) blank to use local ./storage/uploads instead. Set them all to
# switch media to the bucket — no code change needed.
#
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=tedis-media
#   S3_ACCESS_KEY_ID=<R2 access key>
#   S3_SECRET_ACCESS_KEY=<R2 secret key>
#   S3_PUBLIC_URL=https://media.yourdomain.com   # R2 public bucket / custom domain / CDN
# AWS S3: leave S3_ENDPOINT blank, set S3_REGION to the bucket region.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Observability (Increment 16)
SENTRY_DSN=

# Client-side error tracking (safe to expose). Server uses SENTRY_DSN above.
NEXT_PUBLIC_SENTRY_DSN=
